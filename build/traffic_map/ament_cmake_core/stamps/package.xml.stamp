<?xml version="1.0"?>
<package format="3">
  <name>traffic_map</name><version>0.1.0</version>
  <description>ROS 2 OpenDRIVE lane marker visualization.</description>
  <maintainer email="maintainer@example.com">traffic_map maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend><depend>rclcpp</depend>
  <depend>sensor_msgs</depend><depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>gazebo_dev</depend>
  <depend>pugixml</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
