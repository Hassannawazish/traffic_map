<?xml version="1.0"?>
<sdf version="1.6">
  <world name="traffic_world">
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.35 0.55 0.8 1</background></scene>
    <include><uri>model://sun</uri></include>
    <model name="road"><static>true</static><link name="road_link">
      <visual name="asphalt"><geometry><mesh><uri>file:///home/hassan/Desktop/traffic_map/build/gazebo_assets/road_surface.obj</uri></mesh></geometry>
        <material><ambient>0.055 0.06 0.065 1</ambient><diffuse>0.055 0.06 0.065 1</diffuse></material></visual>
      <visual name="white_markings"><geometry><mesh><uri>file:///home/hassan/Desktop/traffic_map/build/gazebo_assets/road_white.obj</uri></mesh></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.35 0.35 0.35 1</emissive></material></visual>
      <visual name="yellow_divider"><geometry><mesh><uri>file:///home/hassan/Desktop/traffic_map/build/gazebo_assets/road_yellow.obj</uri></mesh></geometry>
        <material><ambient>1 0.72 0 1</ambient><diffuse>1 0.72 0 1</diffuse><emissive>0.3 0.2 0 1</emissive></material></visual>
      <visual name="roadside_vegetation"><geometry><mesh><uri>file:///home/hassan/Desktop/traffic_map/build/gazebo_assets/vegetation.obj</uri></mesh></geometry></visual>
      <visual name="sidewalks"><geometry><mesh><uri>file:///home/hassan/Desktop/traffic_map/build/gazebo_assets/sidewalks.obj</uri></mesh></geometry>
        <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.62 0.64 0.66 1</diffuse></material></visual>
    </link></model>
    <plugin name="traffic" filename="libtraffic_world_plugin.so"/>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-12 0 5 0 0.30 0</pose>
        <track_visual>
          <name>traffic_vehicle_0::body::visual</name>
          <static>false</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-12 0 5</xyz>
          <inherit_yaw>true</inherit_yaw>
          <min_dist>4</min_dist>
          <max_dist>60</max_dist>
        </track_visual>
      </camera>
    </gui>
  </world>
</sdf>
